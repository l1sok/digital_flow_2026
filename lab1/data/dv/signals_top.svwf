
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
set id [waveform add -signals [subst  {
	{[format {tb.dut.rst_n}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.clear}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.valid_in}]}
	} ]]
waveform format $id -color #0099ff
set id [waveform add -signals [subst  {
	{[format {tb.dut.operation[1:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.data_a[15:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.data_b[15:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.range_limit[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.result_valid}]}
	} ]]
waveform format $id -color #0099ff
set id [waveform add -signals [subst  {
	{[format {tb.dut.max[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.min[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.count[9:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.range[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.result[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.sum[31:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {tb.dut.range_exceeded}]}
	} ]]

waveform xview limits 0 245000ps
